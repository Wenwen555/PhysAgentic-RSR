
<mujoco model="reconstructed_door">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005"/>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1"/>

    <body name="frame" pos="0 0 0">
      <geom name="post" type="box"
            size="0.05 0.05 1.0"
            pos="-0.06 0 1.0"/>

      <body name="door" pos="0 0 0">
        <joint name="door_hinge"
               type="hinge"
               axis="0 0 1"
               range="0 1.7"
               damping="0.1"
               frictionloss="0.05"/>

        <geom name="door_leaf"
              type="box"
              size="0.4 0.02 1.0"
              pos="0.4 0 1.05"
              density="3.9"/>

        <body name="handle" pos="0.75 0 1.0">
          <joint name="handle_hinge"
                 type="hinge"
                 axis="0 0 1"
                 range="-1.2 1.2"
                 damping="0.02"
                 armature="0.01"/>

          <geom name="handle_bar"
                type="capsule"
                size="0.015 0.06"
                fromto="0 0 -0.08 0 0 0.08"
                density="800"
                contype="0"
                conaffinity="0"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>

